<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Shent.Desktop.Localization"
             xmlns:vm="using:Shent.Desktop.ViewModels"
             xmlns:ui="using:Shent.Desktop.UI"
             x:Class="Shent.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <ScrollViewer Classes="page">
    <StackPanel Spacing="18" Margin="0,0,0,28">

      <Grid ColumnDefinitions="2*,18,*">
        <!-- Hero: saldo -->
        <Border Classes="hero" MinHeight="230">
          <Panel>
            <Path Data="{x:Static ui:Icons.Hexagon}" Width="300" Height="300" Stretch="Uniform" Fill="#14FFFFFF"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-90,-70,0" />
            <Path Data="{x:Static ui:Icons.Hexagon}" Width="160" Height="160" Stretch="Uniform" Fill="#0FFFFFFF"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,130,-70" />

            <!-- Con billetera -->
            <DockPanel IsVisible="{Binding HasWallet}">
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{l:T 'SALDO DISPONIBLE'}" Classes="overline" Foreground="#CCFFFFFF" />
              </StackPanel>
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" Margin="0,18,0,0">
                <Button Classes="glass" Command="{Binding SendCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{x:Static ui:Icons.Send}" />
                    <TextBlock Text="{l:T 'Enviar'}" />
                  </StackPanel>
                </Button>
                <Button Classes="glass" Command="{Binding ReceiveCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{x:Static ui:Icons.Qr}" />
                    <TextBlock Text="{l:T 'Recibir'}" />
                  </StackPanel>
                </Button>
              </StackPanel>
              <StackPanel VerticalAlignment="Center" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Balance}" Classes="display" Foreground="White" />
                  <TextBlock Text="SHENT" FontSize="18" FontWeight="SemiBold" Foreground="#CCFFFFFF" VerticalAlignment="Bottom" Margin="0,0,0,9" />
                </StackPanel>
                <TextBlock Text="{Binding Pending}" IsVisible="{Binding HasPending}" Foreground="#D0FFFFFF" FontSize="13" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Background="#26FFFFFF" CornerRadius="99" Padding="10,4">
                    <TextBlock Text="{Binding Pseudonym}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                  </Border>
                  <TextBlock Text="{Binding ShortAddress}" Foreground="#C0FFFFFF" FontSize="12" Classes="mono" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </DockPanel>

            <!-- Sin billetera -->
            <StackPanel IsVisible="{Binding !HasWallet}" VerticalAlignment="Center" Spacing="10" MaxWidth="520" HorizontalAlignment="Left">
              <TextBlock Text="{l:T 'BIENVENIDO A SHENT'}" Classes="overline" Foreground="#CCFFFFFF" />
              <TextBlock Text="{l:T 'Creá tu billetera y empezá a minar'}" FontSize="30" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" LetterSpacing="-0.5" />
              <TextBlock Foreground="#D8FFFFFF" FontSize="14" TextWrapping="Wrap"
                         Text="{l:T 'Tus claves se generan y se cifran en esta PC. Nadie más las tiene: guardá el respaldo y la contraseña, porque no hay forma de recuperarlas.'}" />
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                <Button Classes="glass" Command="{Binding CreateWalletCommand}" Background="#40FFFFFF">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{x:Static ui:Icons.Plus}" />
                    <TextBlock Text="{l:T 'Crear billetera'}" />
                  </StackPanel>
                </Button>
                <Button Classes="glass" Command="{Binding ImportWalletCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{x:Static ui:Icons.Download}" />
                    <TextBlock Text="{l:T 'Importar respaldo'}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
          </Panel>
        </Border>

        <!-- Minería rápida -->
        <Border Grid.Column="2" Classes="card" Padding="22">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto">
              <Border Classes="iconBadge amber"><PathIcon Data="{x:Static ui:Icons.Flash}" /></Border>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{l:T 'Minería'}" Classes="h3" />
                <TextBlock Text="{Binding MiningHashrate}" Classes="caption" />
              </StackPanel>
              <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsMining, Mode=OneWay}" Command="{Binding ToggleMiningCommand}"
                            OnContent="" OffContent="" VerticalAlignment="Center" />
            </Grid>
            <Button DockPanel.Dock="Bottom" Classes="tonal" HorizontalAlignment="Stretch" Command="{Binding OpenMiningCommand}" Margin="0,12,0,0">
              <TextBlock Text="{l:T 'Abrir panel de minería'}" />
            </Button>
            <ui:SparklineChart Values="{Binding HashrateHistory}" Margin="0,16,0,0" MinHeight="90" />
          </DockPanel>
        </Border>
      </Grid>

      <!-- Indicadores -->
      <UniformGrid Columns="4" Margin="-9,0">
        <Border Classes="card" Margin="9,0" Padding="18">
          <StackPanel Spacing="12">
            <Border Classes="iconBadge" HorizontalAlignment="Left"><PathIcon Data="{x:Static ui:Icons.Cube}" /></Border>
            <StackPanel Spacing="2">
              <TextBlock Text="{l:T 'ALTURA'}" Classes="overline" />
              <TextBlock Text="{Binding Height}" Classes="stat" />
              <TextBlock Text="{Binding LastBlockAgoText}" Classes="caption" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="card" Margin="9,0" Padding="18">
          <StackPanel Spacing="12">
            <Border Classes="iconBadge amber" HorizontalAlignment="Left"><PathIcon Data="{x:Static ui:Icons.Chip}" /></Border>
            <StackPanel Spacing="2">
              <TextBlock Text="{l:T 'HASHRATE DE LA RED'}" Classes="overline" />
              <TextBlock Text="{Binding NetworkHashrate}" Classes="stat" />
              <TextBlock Text="{Binding DifficultyText}" Classes="caption" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="card" Margin="9,0" Padding="18">
          <StackPanel Spacing="12">
            <Border Classes="iconBadge cyan" HorizontalAlignment="Left"><PathIcon Data="{x:Static ui:Icons.Network}" /></Border>
            <StackPanel Spacing="2">
              <TextBlock Text="{l:T 'PARES'}" Classes="overline" />
              <TextBlock Text="{Binding Peers}" Classes="stat" />
              <TextBlock Text="{Binding PeersDetail}" Classes="caption" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="card" Margin="9,0" Padding="18">
          <StackPanel Spacing="12">
            <Border Classes="iconBadge green" HorizontalAlignment="Left"><PathIcon Data="{x:Static ui:Icons.Shield}" /></Border>
            <StackPanel Spacing="2">
              <TextBlock Text="{l:T 'RECOMPENSA'}" Classes="overline" />
              <TextBlock Text="{Binding Subsidy}" Classes="stat" />
              <TextBlock Text="{Binding Mempool}" Classes="caption" />
            </StackPanel>
          </StackPanel>
        </Border>
      </UniformGrid>

      <Grid ColumnDefinitions="2*,18,*">
        <!-- Bloques recientes -->
        <Border Classes="card">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
              <TextBlock Text="{l:T 'Bloques recientes'}" Classes="h2" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="tonal" Padding="14,8" Command="{Binding OpenExplorerCommand}">
                <TextBlock Text="{l:T 'Ver explorador'}" FontSize="13" />
              </Button>
            </Grid>
            <ItemsControl ItemsSource="{Binding RecentBlocks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BlockItem">
                  <Border Classes="tile" Margin="0,0,0,8" Padding="14,12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Classes="iconBadge" Width="40" Height="40">
                        <PathIcon Data="{x:Static ui:Icons.Cube}" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding HeightText}" FontWeight="SemiBold" />
                          <Border Background="{StaticResource AmberSoft}" CornerRadius="99" Padding="8,1" IsVisible="{Binding MinedByMe}">
                            <TextBlock Text="{l:T 'minado por vos'}" FontSize="11" Foreground="{StaticResource Amber}" FontWeight="SemiBold" />
                          </Border>
                        </StackPanel>
                        <TextBlock Classes="caption">
                          <Run Text="{Binding TxText}" />
                          <Run Text="{l:T ' · minero '}" />
                          <Run Text="{Binding MinerShort}" />
                        </TextBlock>
                      </StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                        <TextBlock Text="{Binding Reward, StringFormat='+{0} SHENT'}" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource Amber}" />
                        <TextBlock Text="{Binding TimeAgo}" Classes="caption" HorizontalAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>

        <StackPanel Grid.Column="2" Spacing="18">
          <!-- Suministro -->
          <Border Classes="card">
            <StackPanel Spacing="14">
              <TextBlock Text="{l:T 'Suministro emitido'}" Classes="h2" />
              <Grid ColumnDefinitions="Auto,*">
                <Panel Width="104" Height="104">
                  <ui:ArcGauge Value="{Binding IssuedRatio}" StrokeWidth="11" />
                  <TextBlock Text="{Binding IssuedPercent}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="4">
                  <TextBlock Text="{Binding Issued}" FontWeight="Bold" FontSize="17" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding MaxSupplyText}" Classes="caption" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding NextHalving}" Classes="caption" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Actividad -->
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="{l:T 'Actividad del nodo'}" Classes="h2" />
              <ItemsControl ItemsSource="{Binding Activity}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LogItem">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,10">
                      <Ellipse Classes="dot" Margin="0,6,10,0" VerticalAlignment="Top"
                               Classes.ok="{Binding Level, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=ok}"
                               Classes.warn="{Binding Level, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=warn}"
                               Classes.bad="{Binding Level, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=bad}" />
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="{Binding Message}" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Classes="caption" FontSize="11">
                          <Run Text="{Binding Time}" />
                          <Run Text=" · " />
                          <Run Text="{Binding Category}" />
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
