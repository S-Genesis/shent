# Ejemplo de variables de entorno para shent-node. Copiá este archivo a .env (que NO se versiona)
# y reemplazá los valores entre MAYÚSCULAS por datos reales. No hay credenciales: SHENT no usa
# contraseñas de servidor, claves de API ni servicios de pago.
# shent-node lee las variables del entorno del proceso (no lee .env por sí mismo):
#   Linux/macOS:  set -a; source .env; set +a; ./scripts/start-node.sh
#   systemd:      EnvironmentFile=/etc/shent/shent.env
# Las variables vacías se ignoran.

# Red: mainnet | testnet | regtest
SHENT_NETWORK=mainnet

# Puerto P2P TCP (mainnet 37373, testnet 47373, regtest 57373)
P2P_PORT=37373

# Nodos de arranque, separados por coma. Formato:
#   /ip4/IP_PUBLICA/tcp/PUERTO/p2p/PEER_ID
#   /dns4/DOMINIO/tcp/PUERTO/p2p/PEER_ID
#   /ip4/IP_RELAY/tcp/PUERTO/p2p/PEER_ID_RELAY/p2p-circuit/p2p/PEER_ID_DESTINO
# IP_PUBLICA y PEER_ID los muestra el otro nodo (comando "shent-node id" o la pestaña Red P2P).
# Solo sirven para encontrar pares: no controlan saldos ni deciden qué bloques son válidos.
BOOTSTRAP_NODES=

# Carpeta de datos (vacío = carpeta del usuario: %APPDATA%\SHENT, ~/.shent o ~/Library/Application Support/SHENT)
SHENT_DATADIR=

# 1 = ofrecer relay a nodos sin puertos abiertos (solo en un servidor con IP pública)
SHENT_RELAY=0

# 0 = no intentar abrir el puerto en el router con UPnP
SHENT_UPNP=1

# Descubrimiento automático por Internet (DHT pública de BitTorrent). 1 = activado (por defecto).
SHENT_DHT=1

# Privacidad de red: proxy SOCKS5 local (Tor = 127.0.0.1:9050, Tor Browser = 127.0.0.1:9150).
# Con proxy el nodo no escucha conexiones, no usa la DHT ni la red local y no revela su IP a los pares.
# Las direcciones y montos de la cadena siguen siendo públicos.
SHENT_PROXY=

# Dandelion++: las transacciones propias viajan primero por un camino aleatorio antes de difundirse.
SHENT_DANDELION=1

# Dirección pública fija a anunciar (opcional), por ejemplo /dns4/DOMINIO/tcp/37373
SHENT_ANNOUNCE=

# API local de diagnóstico (solo lectura, solo 127.0.0.1). Puerto por defecto: P2P + 7
SHENT_API=1
SHENT_API_PORT=
